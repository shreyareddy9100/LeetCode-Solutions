class Solution {
public:
    vector<int> twoSum(vector<int>& numbers, int target) {
        vector<int> idx;
        int idx1 = 0, idx2 = numbers.size() - 1;
        while (idx1 < idx2) {
            if (numbers[idx1] + numbers[idx2] == target) {
                
                    idx.push_back(idx1 + 1);
                    idx.push_back(idx2 + 1);
                    break;
                
            } else if (numbers[idx1] + numbers[idx2] > target) {
                idx2--;
            } else {
                idx1++;
            }
        }
        return idx;
    }
};
