class Solution {
public:
    vector<int> relativeSortArray(vector<int>& arr1, vector<int>& arr2) {

        vector<int> freq(1001, 0);

        for (int num : arr1) {
            freq[num]++;
        }

        vector<int> result;

        for (int num : arr2) {

            while (freq[num]--) {
                result.push_back(num);
            }
        }

        for (int i = 0; i <= 1000; i++) {

            while (freq[i]-- > 0) {
                result.push_back(i);
            }
        }

        return result;
    }
};
